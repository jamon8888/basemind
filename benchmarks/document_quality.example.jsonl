{"ner":[{"path":"synthetic-redaction.txt","required_categories":["person","organization","email","phone_number","iban"],"required_texts":["Alice Martin","Acme Conseil","alice.martin@example.test","+33 6 12 34 56 78","FR7630006000011234567890189"]}]}
